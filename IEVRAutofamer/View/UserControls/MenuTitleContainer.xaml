<UserControl x:Class="IEVRAutofamer.View.UserControls.MenuTitleContainer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:IEVRAutofamer.View.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Image x:Name="image"
               Grid.Row="1"
               VerticalAlignment="Center"
               HorizontalAlignment="Left"
               Source="{Binding TitleImage}"
               Stretch="Fill"
               Width="725"
               Height="130"/>

        <StackPanel HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
            <TextBlock x:Name="textBlock"
                   Text="{Binding TitleText}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Left"
                   Margin="55,0,0,0"
                   Opacity="0.95"
                   FontSize="32"
                   FontWeight="Bold"
                   Foreground="#FFECECEC"/>

            <Image x:Name="iconSource"
                   Source="{Binding IconImage}"
                   Stretch="Fill"
                   Height="115"
                   Margin="5,0,0,0" RenderTransformOrigin="0.5,0.5">
                <Image.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.6" ScaleY="0.6"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Image.RenderTransform>
            </Image>

        </StackPanel>

    </Grid>
</UserControl>

